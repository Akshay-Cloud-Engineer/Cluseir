    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^4.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.82.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",

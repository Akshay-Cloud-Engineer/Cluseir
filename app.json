{
  "expo": {
    "name": "Cluseir",
    "slug": "cluseir",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cluseir",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cluseir.app"
    },
    "android": {
      "package": "com.cluseir.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      ["expo-router", { "root": "./src/app" }],
      "expo-font"
    ]
  }
}
